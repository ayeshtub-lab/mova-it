generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── People ────────────────────────────────────────────────────────────────

// A guest (web visitor who only typed a name) is a User with isGuest = true
// and no phone; signing in with a phone later upgrades the same row.
model User {
  id          String   @id @default(cuid())
  phone       String?  @unique
  displayName String
  avatarUrl   String?
  locale      String   @default("ar")
  isGuest     Boolean  @default(true)
  isAdmin     Boolean  @default(false) // may open /admin to review reports
  isSystem    Boolean  @default(false) // the «زاومو» account that starts «لحظة اليوم»
  // Official account: Google's stable user id. A guest who signs in with Google keeps
  // the same row (and everything they made); isGuest becomes false.
  googleSub   String?  @unique
  email       String? // private, never shown to other users
  googleName  String? // name on the Google account, offered as a one-tap choice
  createdAt   DateTime @default(now())

  sessions        Session[]
  createdMoments  Moment[]         @relation("MomentCreator")
  angles          Angle[]
  reactions       Reaction[]
  comments        Comment[]
  blocking        Block[]          @relation("Blocker")
  blockedBy       Block[]          @relation("Blocked")
  invitesSent     MomentInvite[]   @relation("InvitesSent")
  invitesReceived MomentInvite[]   @relation("InvitesReceived")
  directMessages  DirectMessage[]
  angleViews      AngleView[]
  dailyVotes      DailyVote[]
  savedAngles     SavedAngle[]
  participations  Participant[]
  following       Follow[]         @relation("Follower")
  followers       Follow[]         @relation("Following")
  reports         Report[]
  removalRequests RemovalRequest[]
}

// Opaque random token in an httpOnly cookie (web) or a bearer header (app later);
// only its SHA-256 is stored, so a leaked database row cannot be replayed.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// ── Moments ───────────────────────────────────────────────────────────────

enum MomentKind {
  EVERYDAY // created by someone: a trip, a sunset, a hangout
  BIG // announced synchronized moment: a match, iftar, new year
  DAILY // the "moment of the day" prompt
}

enum Visibility {
  FRIENDS // default: followers of the creator + participants
  LINK // anyone holding the link
  PUBLIC // eligible for the public feed
}

enum ModerationStatus {
  ACTIVE
  HIDDEN
}

model Moment {
  id             String           @id @default(cuid())
  code           String           @unique // short share code: /m/K7M2Q4
  title          String
  // A short line under the title; may carry #hashtags (public ones link to /tag/…).
  description    String?
  kind           MomentKind       @default(EVERYDAY)
  visibility     Visibility       @default(FRIENDS)
  status         ModerationStatus @default(ACTIVE)
  // Approximate place only: a name, and coordinates rounded to 2 decimals (~1 km).
  placeName      String?
  latApprox      Float?
  lngApprox      Float?
  // Angles hide until this time ("reveal"); "give to get" lives in app logic.
  revealAt       DateTime?
  // A moment that gathered enough angles is kept ("لحظة خالدة"); its angles stop expiring.
  isPermanent    Boolean          @default(false)
  creatorId      String
  createdAt      DateTime         @default(now())
  lastActivityAt DateTime         @default(now()) // drives "why now" ranking

  creator      User           @relation("MomentCreator", fields: [creatorId], references: [id])
  angles       Angle[]
  participants Participant[]
  invites      MomentInvite[]
  daily        DailyPlan?
  montages     Montage[]
  reports      Report[]

  @@index([lastActivityAt])
  @@index([creatorId])
}

enum ParticipantRole {
  HOST
  CONTRIBUTOR
  VIEWER
}

model Participant {
  momentId String
  userId   String
  role     ParticipantRole @default(VIEWER)
  joinedAt DateTime        @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([momentId, userId])
  @@index([userId])
}

// ── Angles (one person's photo or ≤20 s video of a moment) ────────────────

enum MediaType {
  PHOTO
  VIDEO
}

enum Presence {
  THERE // "كنت هناك"
  REMOTE // "من بعيد" — a reaction from elsewhere (BIG moments)
}

enum AngleStatus {
  PROCESSING // uploaded, video still encoding
  READY
  HIDDEN // hidden by the moment's host or moderation
  REMOVED // removal request approved
}

model Angle {
  id            String      @id @default(cuid())
  momentId      String
  contributorId String
  mediaType     MediaType
  presence      Presence    @default(THERE)
  status        AngleStatus @default(PROCESSING)
  // Pathnames in the private Blob store; viewers get short-lived signed URLs.
  mediaPath     String? // the photo (JPEG) or the video file
  thumbPath     String? // video poster frame (JPEG)
  streamUid     String? // Cloudflare Stream id, once videos move there
  durationSec   Float? // videos only; the upload flow enforces ≤ 20
  width         Int?
  height        Int?
  capturedAt    DateTime? // read from the file on the device before upload
  uploadedAt    DateTime    @default(now())
  expiresAt     DateTime? // 24 h unless the moment becomes permanent
  // Automatic content check (Gemini) when the upload completes.
  screening     String? // "allowed" | "blocked" | "error"; null = not checked
  screenedAt    DateTime?
  // A sound from the library (src/lib/sounds.ts) played with the angle, and whether a
  // video's own sound is muted under it.
  soundKey      String?
  muteOriginal  Boolean     @default(false)

  moment          Moment           @relation(fields: [momentId], references: [id], onDelete: Cascade)
  contributor     User             @relation(fields: [contributorId], references: [id])
  reactions       Reaction[]
  comments        Comment[]
  views           AngleView[]
  saves           SavedAngle[]
  reports         Report[]
  removalRequests RemovalRequest[]

  @@index([momentId, capturedAt])
  @@index([contributorId])
  @@index([expiresAt])
  @@index([soundKey])
}

// ── Reactions ─────────────────────────────────────────────────────────────

enum ReactionKind {
  HEART // ❤️
  LAUGH // 😂
  FIRE // 🔥
  WOW // 😮
}

// One reaction per person per angle; reacting again with another emoji replaces it.
// Who has seen an angle (once per person). Only the angle's owner sees the count.
model AngleView {
  angleId   String
  userId    String
  createdAt DateTime @default(now())

  angle Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([angleId, userId])
  @@index([userId])
}

// Bookmarks («المحفوظات»): private to the person who saved.
model SavedAngle {
  userId    String
  angleId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  angle Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)

  @@id([userId, angleId])
  @@index([userId, createdAt])
}

// Only ❤️ is offered now; the other kinds stay in the enum for old rows.
model Reaction {
  angleId   String
  userId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  angle Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([angleId, userId])
}

// ── Comments ──────────────────────────────────────────────────────────────

// A short comment on one angle. Deleted by its author or the moment's creator.
model Comment {
  id        String   @id @default(cuid())
  angleId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  angle   Angle    @relation(fields: [angleId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([angleId, createdAt])
  @@index([userId, createdAt])
}

// ── Invites between friends ───────────────────────────────────────────────

// "X sent you a moment": shown on the recipient's home page for 24 hours. Only between
// people who already shared a moment (see src/server/friends.ts) — no phone numbers.
// A moment one friend sent another. It doubles as their inbox thread about that
// moment (quick replies in DirectMessage). Each side has its own "seen up to" time.
model MomentInvite {
  id             String    @id @default(cuid())
  momentId       String
  fromUserId     String
  toUserId       String
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  fromSeenAt     DateTime?
  toSeenAt       DateTime?

  moment   Moment          @relation(fields: [momentId], references: [id], onDelete: Cascade)
  fromUser User            @relation("InvitesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User            @relation("InvitesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([momentId, fromUserId, toUserId])
  @@index([toUserId, createdAt])
  @@index([toUserId, lastActivityAt])
  @@index([fromUserId, lastActivityAt])
}

model DirectMessage {
  id        String   @id @default(cuid())
  inviteId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  invite MomentInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inviteId, createdAt])
  @@index([senderId, createdAt])
}

// ── Montage (automatic multi-angle video) ─────────────────────────────────

enum MontageStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

model Montage {
  id          String        @id @default(cuid())
  momentId    String
  status      MontageStatus @default(QUEUED)
  angleIds    String[] // the angles used, in cut order
  soundKey    String? // library sound mixed under the whole montage
  videoUrl    String?
  durationSec Float?
  error       String?
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@index([momentId])
}

// ── Safety ────────────────────────────────────────────────────────────────

model Report {
  id         String    @id @default(cuid())
  reporterId String?
  momentId   String?
  angleId    String?
  commentId  String?
  reason     String
  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolution String? // "hidden" | "deleted" | "dismissed"

  reporter User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  moment   Moment?  @relation(fields: [momentId], references: [id], onDelete: Cascade)
  angle    Angle?   @relation(fields: [angleId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
  @@index([reporterId, createdAt])
}

// "Block": the blocked person can no longer send you moments or messages, and you no
// longer see their comments. Silent — they are not told.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum RemovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// "Remove me from this angle": someone who appears in it asks the host to take it down.
model RemovalRequest {
  id          String        @id @default(cuid())
  angleId     String
  requesterId String
  note        String?
  status      RemovalStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  decidedAt   DateTime?

  angle     Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status])
}

// «لحظة اليوم»: one plan per day. A day runs from 06:00 to 06:00 Mecca time (03:00 UTC)
// and is keyed by its date ("2026-09-25"). The theme comes from the curated list
// (src/lib/dailyThemes.ts): the vote winner, an admin's pick, or a seeded random one.
model DailyPlan {
  day       String   @id
  themeKey  String
  source    String // "vote" | "random" | "admin"
  momentId  String?  @unique
  createdAt DateTime @default(now())

  moment Moment? @relation(fields: [momentId], references: [id], onDelete: SetNull)
}

// A vote for the theme of a coming day (one per person per day, may be changed).
model DailyVote {
  day       String
  userId    String
  themeKey  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
  @@index([day, themeKey])
}
