generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── People ────────────────────────────────────────────────────────────────

// A guest (web visitor who only typed a name) is a User with isGuest = true
// and no phone; signing in with a phone later upgrades the same row.
model User {
  id          String   @id @default(cuid())
  phone       String?  @unique
  displayName String
  avatarUrl   String?
  locale      String   @default("ar")
  isGuest     Boolean  @default(true)
  isAdmin     Boolean  @default(false) // may open /admin to review reports
  isSystem    Boolean  @default(false) // the «زاومو» account that starts «لحظة اليوم»
  verified    Boolean  @default(false) // ✓ an official Zawmo account: a badge by its name, its comments first
  // «اسمح للي صوّروا نفس اللحظة ينضمّوا للحظاتي»: when off, this person's moments are never
  // suggested to others (src/server/join.ts).
  allowJoins  Boolean  @default(true)
  // Official account: Google's stable user id. A guest who signs in with Google keeps
  // the same row (and everything they made); isGuest becomes false.
  googleSub   String?  @unique
  email       String? // private, never shown to other users
  googleName  String? // name on the Google account, offered as a one-tap choice
  // Where this person first came from (an ad's «?src=tiktok-house», a UTM source, or the referring
  // site: google, whatsapp…), for the admin's per-campaign numbers. Never shown to anyone else.
  source      String?
  // Roughly where they are, from their connection when they joined (Vercel's IP location:
  // "SA", "Riyadh"), for per-country Zawmo and local ads later. Never shown to anyone else.
  country     String?
  city        String?
  createdAt   DateTime @default(now())

  sessions        Session[]
  createdMoments  Moment[]         @relation("MomentCreator")
  angles          Angle[]
  reactions       Reaction[]
  comments        Comment[]
  blocking        Block[]          @relation("Blocker")
  blockedBy       Block[]          @relation("Blocked")
  invitesSent     MomentInvite[]   @relation("InvitesSent")
  invitesReceived MomentInvite[]   @relation("InvitesReceived")
  directMessages  DirectMessage[]
  angleViews      AngleView[]
  dailyVotes      DailyVote[]
  savedAngles     SavedAngle[]
  activeDays      ActiveDay[]
  commentLikes    CommentLike[]
  momentLikes     MomentLike[]
  notifications   Notification[]   @relation("NotificationsReceived")
  notified        Notification[]   @relation("NotificationsSent")
  presences       SitePresence[]
  pushDevices     PushDevice[]
  // The home page's «N members added M angles» counts from homeSinceAt: the start of
  // the previous visit (a visit = home views less than 30 minutes apart).
  homeSeenAt      DateTime?
  homeSinceAt     DateTime?
  participations  Participant[]
  following       Follow[]         @relation("Follower")
  followers       Follow[]         @relation("Following")
  reports         Report[]
  removalRequests RemovalRequest[]
}

// Opaque random token in an httpOnly cookie (web) or a bearer header (app later);
// only its SHA-256 is stored, so a leaked database row cannot be replayed.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// ── Moments ───────────────────────────────────────────────────────────────

enum MomentKind {
  EVERYDAY // created by someone: a trip, a sunset, a hangout
  BIG // announced synchronized moment: a match, iftar, new year
  DAILY // the "moment of the day" prompt
  STORY // «مع الوقت»: one thing over days, weeks or months (a plant, a house), shot by its owner
}

enum Visibility {
  FRIENDS // default: followers of the creator + participants
  LINK // anyone holding the link
  PUBLIC // eligible for the public feed
}

enum ModerationStatus {
  ACTIVE
  HIDDEN
}

model Moment {
  id             String           @id @default(cuid())
  code           String           @unique // short share code: /m/K7M2Q4
  title          String
  // false: started without a name (a placeholder title); its creator names it at «نشر».
  named          Boolean          @default(true)
  // A short line under the title; may carry #hashtags (public ones link to /tag/…).
  description    String?
  kind           MomentKind       @default(EVERYDAY)
  visibility     Visibility       @default(FRIENDS)
  status         ModerationStatus @default(ACTIVE)
  // Where it happened: a standard place (city, village, neighbourhood — see Place), and
  // optionally a spot typed by the creator («برك سليمان»). Never coordinates.
  placeId        String?
  placeName      String?
  // Angles hide until this time ("reveal"); "give to get" lives in app logic.
  revealAt       DateTime?
  // A moment that gathered enough angles is kept ("لحظة خالدة"); its angles stop expiring.
  isPermanent    Boolean          @default(false)
  creatorId      String
  createdAt      DateTime         @default(now())
  lastActivityAt DateTime         @default(now()) // drives "why now" ranking
  // «مع الوقت»: when its owner was last reminded to add a shot, and how many times since
  // their last shot (reminders stop after a few; a new shot starts them over).
  remindedAt     DateTime?
  reminders      Int              @default(0)

  creator      User           @relation("MomentCreator", fields: [creatorId], references: [id])
  place        Place?         @relation(fields: [placeId], references: [id])
  angles       Angle[]
  participants Participant[]
  invites      MomentInvite[]
  daily        DailyPlan?
  montages     Montage[]
  likes        MomentLike[]
  reports      Report[]

  @@index([lastActivityAt])
  @@index([creatorId])
  // An illustrative example (AI-made, for explaining Zawmo): opens by its link and on its
  // owner's profile, but is never listed with real people's moments (feeds, wheel, places,
  // search engines, «صوّر معك»).
  demo Boolean @default(false)
}

enum ParticipantRole {
  HOST
  CONTRIBUTOR
  VIEWER
}

model Participant {
  momentId String
  userId   String
  role     ParticipantRole @default(VIEWER)
  joinedAt DateTime        @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([momentId, userId])
  @@index([userId])
}

// ── Angles (one person's photo or ≤20 s video of a moment) ────────────────

enum MediaType {
  PHOTO
  VIDEO
}

enum Presence {
  THERE // "كنت هناك"
  REMOTE // "من بعيد" — a reaction from elsewhere (BIG moments)
}

enum AngleStatus {
  PROCESSING // uploaded, video still encoding
  DRAFT // checked and fine, waiting for its owner's «نشر» (after «صوّر معك» looked for a match)
  READY
  HIDDEN // hidden by the moment's host or moderation
  REMOVED // removal request approved
}

model Angle {
  id            String      @id @default(cuid())
  momentId      String
  contributorId String
  mediaType     MediaType
  presence      Presence    @default(THERE)
  status        AngleStatus @default(PROCESSING)
  // Pathnames in the private Blob store; viewers get short-lived signed URLs.
  mediaPath     String? // the photo (JPEG) or the video file
  thumbPath     String? // video poster frame (JPEG)
  smallPath     String? // small JPEG for grids and covers (made on the server after upload)
  streamUid     String? // Cloudflare Stream copy of a video (src/server/stream.ts)
  streamReady   Boolean     @default(false) // Stream finished encoding: play it from there (HLS)
  durationSec   Float? // videos only; the upload flow enforces ≤ 40
  width         Int?
  height        Int?
  capturedAt    DateTime? // read from the file on the device before upload
  uploadedAt    DateTime    @default(now())
  expiresAt     DateTime? // 24 h unless the moment becomes permanent
  // Automatic content check (Gemini) when the upload completes.
  screening     String? // "allowed" | "blocked" | "error"; null = not checked
  screenedAt    DateTime?
  // A sound from the library (src/lib/sounds.ts) played with the angle, and whether a
  // video's own sound is muted under it.
  soundKey      String?
  muteOriginal  Boolean     @default(false)
  // Times someone tapped «share» on it (for «الأكثر رواجًا هذا الأسبوع»).
  shares        Int         @default(0)
  // The look chosen after upload (src/lib/filters.ts): applied when shown and burnt into
  // montages; the stored file is never changed. stamp = the retro date/time in a corner.
  filter        String?
  stamp         Boolean     @default(false)
  // Writing (with emoji) on the shot: a transparent PNG drawn on the owner's phone (so the
  // emoji look the same everywhere, montages included), placed on a 9:16 frame.
  // { text, path, y (centre, 0–1 of height), w (0–1 of width) } — see src/lib/caption.ts.
  caption       Json?
  // Where the shot was taken (Place), found silently: from the photo's own location on the
  // phone (the coordinates never leave it), else the moment's place. placeVerified = it came
  // from the photo and the photo is recent («موثّق ✓»). ipCountryMatch = the uploader's
  // network country matched the place's (the IP itself is not kept).
  placeId        String?
  placeFrom      PlaceSource?
  placeVerified  Boolean     @default(false)
  ipCountryMatch Boolean?
  // What it shows (src/lib/scenes.ts), from the content check: «غروب», «مطر»… Drives «صوّر معك».
  scene          String?
  // «⭐ اختيار زاومو»: when an official (verified) account picked this public shot; picked
  // shots carry a badge and lead the home wheel, the showcase and «اكتشف».
  pickedAt       DateTime?
  // What the check read on the picture, like a lens: visible names (a sign, a venue) and a
  // landmark. Matched between shots by «صوّر معك».
  seenText       String?
  // The town the uploader's network is in (Vercel's guess from the connection, often coarse):
  // used ONLY to match «صوّر معك», never shown anywhere. The address itself is not kept.
  networkPlaceId String?
  // «صوّر معك»: the shot joined someone else's moment from one of its owner's. What that
  // moment was, so the host's «شيلها» can give the shot back a moment of its own.
  // { momentId, title, visibility, placeId }
  joinedFrom     Json?
  // The moment «صوّر معك» offered this shot (so «ضيف» joins exactly what was shown).
  joinOffer      String?

  moment          Moment           @relation(fields: [momentId], references: [id], onDelete: Cascade)
  place           Place?           @relation(fields: [placeId], references: [id])
  contributor     User             @relation(fields: [contributorId], references: [id])
  reactions       Reaction[]
  comments        Comment[]
  views           AngleView[]
  notifications   Notification[]
  saves           SavedAngle[]
  reports         Report[]
  removalRequests RemovalRequest[]

  @@index([momentId, capturedAt])
  @@index([contributorId])
  @@index([expiresAt])
  @@index([soundKey])
  @@index([placeId])
  @@index([scene, capturedAt])
}

// ── Places ────────────────────────────────────────────────────────────────

// The Arab world's places, from open data (tools/places): countries, Palestine's
// governorates and every locality, other countries' big cities, and neighbourhoods.
// Ids are stable ("ps-452240" = PCBS code, "gn-…" = GeoNames, "osm-…" = OpenStreetMap).
enum PlaceKind {
  COUNTRY
  GOVERNORATE
  CITY
  TOWN
  VILLAGE
  CAMP
  NEIGHBOURHOOD
}

// How a shot got its place.
enum PlaceSource {
  PHOTO // the photo's own location, matched on the phone
  MOMENT // the moment's place
  OWNER // chosen by the shot's owner
}

model Place {
  id          String    @id
  kind        PlaceKind
  parentId    String?
  countryCode String
  nameAr      String
  nameEn      String?
  slug        String    @unique // the page address: /p/بيت-لحم
  search      String // normalized names for matching (src/lib/arabic.ts)
  lat         Float // the place's centre (public), never a person's position
  lng         Float
  population  Int?

  parent   Place?   @relation("PlaceTree", fields: [parentId], references: [id])
  children Place[]  @relation("PlaceTree")
  moments  Moment[]
  angles   Angle[]

  @@index([parentId])
  @@index([countryCode])
}

// ── Reactions ─────────────────────────────────────────────────────────────

enum ReactionKind {
  HEART // ❤️
  LAUGH // 😂
  FIRE // 🔥
  WOW // 😮
}

// One reaction per person per angle; reacting again with another emoji replaces it.
// Who has seen an angle (once per person). Only the angle's owner sees the count.
model AngleView {
  angleId   String
  userId    String
  createdAt DateTime @default(now())

  angle Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([angleId, userId])
  @@index([userId])
}

// One row per signed-in person per day they opened Zawmo (Mecca calendar day), for the
// admin dashboard's active users and return rates. Nothing else about the visit is kept.
model ActiveDay {
  userId String
  day    String // "2026-09-26"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// Bookmarks («المحفوظات»): private to the person who saved.
model SavedAngle {
  userId    String
  angleId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  angle Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)

  @@id([userId, angleId])
  @@index([userId, createdAt])
}

// Only ❤️ is offered now; the other kinds stay in the enum for old rows.
model Reaction {
  angleId   String
  userId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  angle Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([angleId, userId])
}

// ── Comments ──────────────────────────────────────────────────────────────

// A short comment on one angle. Deleted by its author or the moment's creator.
model Comment {
  id        String   @id @default(cuid())
  angleId   String
  userId    String
  body      String
  // A reply points at the top-level comment it answers (one level, like TikTok).
  parentId  String?
  createdAt DateTime @default(now())

  angle         Angle          @relation(fields: [angleId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports       Report[]
  parent        Comment?       @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("Replies")
  likes         CommentLike[]
  notifications Notification[]

  @@index([angleId, createdAt])
  @@index([userId, createdAt])
}

// ❤️ on a comment: one per person.
model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

// ── Invites between friends ───────────────────────────────────────────────

// "X sent you a moment": shown on the recipient's home page for 24 hours. Only between
// people who already shared a moment (see src/server/friends.ts) — no phone numbers.
// A moment one friend sent another. It doubles as their inbox thread about that
// moment (quick replies in DirectMessage). Each side has its own "seen up to" time.
model MomentInvite {
  id             String    @id @default(cuid())
  momentId       String
  fromUserId     String
  toUserId       String
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  fromSeenAt     DateTime?
  toSeenAt       DateTime?

  moment   Moment          @relation(fields: [momentId], references: [id], onDelete: Cascade)
  fromUser User            @relation("InvitesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User            @relation("InvitesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([momentId, fromUserId, toUserId])
  @@index([toUserId, createdAt])
  @@index([toUserId, lastActivityAt])
  @@index([fromUserId, lastActivityAt])
}

model DirectMessage {
  id        String   @id @default(cuid())
  inviteId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  invite MomentInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inviteId, createdAt])
  @@index([senderId, createdAt])
}

// ── Montage (automatic multi-angle video) ─────────────────────────────────

enum MontageStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

model Montage {
  id          String        @id @default(cuid())
  momentId    String
  status      MontageStatus @default(QUEUED)
  angleIds    String[] // the angles used, in cut order
  // What it was made from (angles, their looks and sounds, the montage sound): a change
  // to any of them makes a fresh montage.
  signature   String?
  soundKey    String? // library sound mixed under the whole montage
  videoUrl    String?
  durationSec Float?
  error       String?
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@index([momentId])
}

// Hearts on a moment's ready video (its montage). Kept on the moment, so they stay when
// the video is remade with new angles.
model MomentLike {
  momentId  String
  userId    String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([momentId, userId])
}

// ── Notifications and presence ────────────────────────────────────────────

enum NotificationKind {
  LIKE // a heart on your shot
  FOLLOW // someone started following you
  COMMENT // a comment on your shot
  REPLY // a reply to your comment
  NEW_ANGLE // someone else added an angle to a moment you have an angle in
  JOINED // «صوّر معك»: someone who shot the same moment added their shot to your moment
  STORY_REMINDER // «مع الوقت»: a week since the last shot of your story (from Zawmo)
  VIDEO_READY // your moment reached enough shots for its video: make it (from Zawmo, once)
  PICKED // «⭐ اختيار زاومو»: an official account picked your shot
}

// What shows at the top of «الوارد»: who did what to your shots, comments or profile.
model Notification {
  id        String           @id @default(cuid())
  userId    String // who is told
  actorId   String // who did it
  kind      NotificationKind
  angleId   String?
  commentId String?
  createdAt DateTime         @default(now())
  readAt    DateTime?
  // Grouped: «سلمى حبّت ٥ من لقطاتك» is one notice (and one push), not five.
  count     Int              @default(1)

  user    User     @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  angle   Angle?   @relation(fields: [angleId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actorId])
}

// A phone or browser that asked for notifications (Web Push). One person may have several;
// a device the push service no longer knows (404/410) is removed when we next send.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("ar") // the language notifications are written in
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Who has the site open right now (the admin dashboard's live visitors): one row per
// browser, keyed by a random id it keeps; signed in or not.
model SitePresence {
  key      String   @id
  userId   String?
  path     String?
  lastSeen DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([lastSeen])
}

// ── Safety ────────────────────────────────────────────────────────────────

model Report {
  id         String    @id @default(cuid())
  reporterId String?
  momentId   String?
  angleId    String?
  commentId  String?
  reason     String
  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolution String? // "hidden" | "deleted" | "dismissed"

  reporter User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  moment   Moment?  @relation(fields: [momentId], references: [id], onDelete: Cascade)
  angle    Angle?   @relation(fields: [angleId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
  @@index([reporterId, createdAt])
}

// "Block": the blocked person can no longer send you moments or messages, and you no
// longer see their comments. Silent — they are not told.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum RemovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// "Remove me from this angle": someone who appears in it asks the host to take it down.
model RemovalRequest {
  id          String        @id @default(cuid())
  angleId     String
  requesterId String
  note        String?
  status      RemovalStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  decidedAt   DateTime?

  angle     Angle @relation(fields: [angleId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status])
}

// «لحظة اليوم»: one plan per day. A day runs from 06:00 to 06:00 Mecca time (03:00 UTC)
// and is keyed by its date ("2026-09-25"). The theme comes from the curated list
// (src/lib/dailyThemes.ts): the vote winner, an admin's pick, or a seeded random one.
model DailyPlan {
  day       String   @id
  themeKey  String
  source    String // "vote" | "random" | "admin"
  momentId  String?  @unique
  createdAt DateTime @default(now())

  moment Moment? @relation(fields: [momentId], references: [id], onDelete: SetNull)
}

// A vote for the theme of a coming day (one per person per day, may be changed).
model DailyVote {
  day       String
  userId    String
  themeKey  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
  @@index([day, themeKey])
}

// ── Rate limits ───────────────────────────────────────────────────────────

// How many times a person (or a network, hashed) did one kind of action in the current
// window (src/server/rate-limit.ts). Old rows are removed by the daily clean-up.
model RateLimit {
  key     String   @id // "<action>:<user id>" or "<action>:ip:<hash>"
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Ad landings: how many new visitors reached /start from each campaign each day (Mecca day).
// With the ad platform's clicks on one side and sign-ups on the other, it tells a bad
// campaign (clicks that never arrive) from a weak page or app (arrivals who don't join).
model SourceVisit {
  day    String // "2026-10-01"
  source String
  visits Int    @default(0)
  // Of those, how many started typing their name, and how many pressed «ابدأ» (the funnel
  // before «انضموا»: where ad visitors leave).
  typed  Int    @default(0)
  tried  Int    @default(0)

  @@id([day, source])
}
